# Placeholder .env.example — DO NOT commit secrets
# Copy to .env.local and fill with your values

# Hyperliquid exchange keys
# Main account address for querying account state/info
HYPERLIQUID_WALLET_ADDRESS=0x...

# API wallet private key for signing orders
HL_ACCOUNT_NAME=hermes-trader
HYPERLIQUID_PRIVATE_KEY=0x...

# LLM configuration (OpenAI-compatible endpoint)
LLM_BASE_URL=http://127.0.0.1:13305/api/v1
LLM_API_KEY=local
LLM_MODEL=Qwen3.5-9B-The-Defiant-Fable-Uncensored-Heretic-NEO-IMATRIX-MAX-MTP-GGUF-Q4_K_M

