# Hermes Trader — .env.local template
# Copy to .env.local, fill in real values, keep it out of git:
#   cp .env.example .env.local
# .env.local is loaded at process start — after editing, run:
#   docker compose up -d --force-recreate hermes-trader

# ── Hyperliquid ──────────────────────────────────────────────────────────────
# Main account address used to query account state/info.
HYPERLIQUID_WALLET_ADDRESS=0x...
# Agent/API wallet private key used to sign orders (not the main account key
# unless you run the bot on the main account).
HL_ACCOUNT_NAME=hermes-trader
HYPERLIQUID_PRIVATE_KEY=0x...
# Optional: master account, only when using the agent-wallet (delegated key)
# setup.
# HYPERLIQUID_MASTER_ADDRESS=0x...

# ── LLM (OpenAI-compatible endpoint) ─────────────────────────────────────────
# Any /chat/completions server works — a local inference server on the
# llama-net Docker network, or a hosted one. See docs/OPERATIONS.md
# ("External LLM (reference)") for the lemonade setup.
LLM_BASE_URL=http://lemond:13305/api/v1
LLM_API_KEY=local
LLM_MODEL=<your-model>

# (Optional) Legacy OpenRouter fallback — ignored when LLM_* are set.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ── News (optional) ──────────────────────────────────────────────────────────
# Brave Search API key; without it news context is "no news".
# Get one at https://api.search.brave.com/
# BRAVE_API_KEY=

# ── Scan tuning (optional — defaults shown) ──────────────────────────────────
# HERMES_SCAN_INTERVAL=60        # seconds between scan cycles
# HERMES_MAX_MARKETS=60          # total candle-fetch budget per scan
# HERMES_MAX_MARKETS_HIP3=25     # of that budget, slots reserved for HIP-3
#                                # (the rest go to native crypto — same weight)
# HERMES_BATCH_SIZE=20           # markets per parallel batch
# HERMES_BATCH_SLEEP=0.3         # seconds between batches
# HERMES_WATCHDOG_TIMEOUT_S=600  # max seconds a scan may run before being killed